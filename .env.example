NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required to record verified Square/PayPal payments on orders.
# Obtain from Supabase Project Settings → API → service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Square (Developer Dashboard → Applications)
# Use Sandbox first. Set SQUARE_ENVIRONMENT=production only after sandbox QA.
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# PayPal (Developer Dashboard → Apps & Credentials)
# Use Sandbox first. Set PAYPAL_ENVIRONMENT=production only after sandbox QA.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Optional transactional email. Leave empty to skip sending; orders still succeed.
# Set ORDER_EMAIL_FROM plus one provider key. Do not commit real credentials.
ORDER_EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
