NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local development. Production must be the public storefront only:
# NEXT_PUBLIC_SITE_URL=https://ivoire-shop-five.vercel.app
# Never use a Vercel deployment hostname or team alias (those require Sign into Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local development. Production must be the public storefront only:
# NEXT_PUBLIC_SITE_URL=https://ivoire-shop-five.vercel.app
# Never use a Vercel deployment hostname or team alias (those require Sign into Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required to record verified payments and unpaid shipping/tax snapshots.
# Obtain from Supabase Project Settings → API → service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST MODE first. Do not set live keys until the owner explicitly activates live.
# Add these in Vercel Production (and locally) without pasting secrets into chat.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook URL: https://ivoire-shop-five.vercel.app/api/payments/stripe/webhook
# Stripe Dashboard → Developers → Webhooks → payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, charge.refunded

# Optional transactional email. Leave empty to skip sending; orders still succeed.
# Set ORDER_EMAIL_FROM plus one provider key. Do not commit real credentials.
ORDER_EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=

# Local delivery / shipping (server-only). Never expose these to the browser.
# DOORDASH_DEVELOPER_ID=
# DOORDASH_KEY_ID=
# DOORDASH_SIGNING_SECRET=
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# UPS_ACCOUNT_NUMBER=
# USPS_CONSUMER_KEY=
# USPS_CONSUMER_SECRET=

# Optional transactional email. Leave empty to skip sending; orders still succeed.
# Set ORDER_EMAIL_FROM plus one provider key. Do not commit real credentials.
ORDER_EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=

